# ===================
# App Configuration
# ===================
# Must be an origin only. HTTP is accepted only for localhost/loopback.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===================
# Database
# ===================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anonli"

# ===================
# Authentication
# ===================
# Generate each secret independently: openssl rand -base64 32
AUTH_SECRET=""

# Turnstile (Bot Protection) — required; the captcha is always enforced.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# OAuth Providers (optional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===================
# Email (Resend)
# ===================
AUTH_RESEND_KEY=""

# ===================
# Stripe Payments
# ===================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Price IDs are optional until the corresponding checkout flow is enabled.
# Stripe Price IDs - Bundle Plans
STRIPE_BUNDLE_PLUS_MONTHLY_PRICE_ID=""
STRIPE_BUNDLE_PLUS_YEARLY_PRICE_ID=""
STRIPE_BUNDLE_PRO_MONTHLY_PRICE_ID=""
STRIPE_BUNDLE_PRO_YEARLY_PRICE_ID=""

# Stripe Price IDs - Alias Plans
STRIPE_ALIAS_PLUS_MONTHLY_PRICE_ID=""
STRIPE_ALIAS_PLUS_YEARLY_PRICE_ID=""
STRIPE_ALIAS_PRO_MONTHLY_PRICE_ID=""
STRIPE_ALIAS_PRO_YEARLY_PRICE_ID=""

# Stripe Price IDs - Drop Plans
STRIPE_DROP_PLUS_MONTHLY_PRICE_ID=""
STRIPE_DROP_PLUS_YEARLY_PRICE_ID=""
STRIPE_DROP_PRO_MONTHLY_PRICE_ID=""
STRIPE_DROP_PRO_YEARLY_PRICE_ID=""

# Stripe Price IDs - Form Plans
STRIPE_FORM_PLUS_MONTHLY_PRICE_ID=""
STRIPE_FORM_PLUS_YEARLY_PRICE_ID=""
STRIPE_FORM_PRO_MONTHLY_PRICE_ID=""
STRIPE_FORM_PRO_YEARLY_PRICE_ID=""

# Stripe Price IDs - Business (Teams, per-seat)
STRIPE_BUSINESS_MONTHLY_PRICE_ID=""
STRIPE_BUSINESS_YEARLY_PRICE_ID=""

# ===================
# Cloudflare R2 Storage
# ===================
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Private S3 API endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_BUCKET_NAME=""
# Keep the bucket private. Do not enable an r2.dev URL or public custom domain:
# public object access bypasses Drop expiry, revocation, and download limits.

# ===================
# Rate Limiting (Upstash) — required in all environments
# ===================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Vercel is auto-detected. For a Cloudflare-only self-hosted origin, use
# "cloudflare" and firewall the origin so direct requests cannot spoof headers.
TRUSTED_PROXY_PROVIDER=""

# ===================
# Cron Jobs
# ===================
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ===================
# Abuse Reporting
# ===================
# Generate independently: openssl rand -base64 32
IP_HASH_PEPPER=""
# Required 64-character hex key (32 bytes): openssl rand -hex 32
REPORT_ENCRYPTION_KEY=""

# ===================
# DKIM Key Encryption
# ===================
# Required 64-character hex key: openssl rand -hex 32
DKIM_ENCRYPTION_KEY=""

# ===================
# NowPayments (optional crypto payments)
# ===================
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# ===================
# Analytics & Observability (PostHog, optional)
# ===================
# Project API key (public). Leave empty to disable analytics + error tracking.
NEXT_PUBLIC_POSTHOG_KEY=""
# Client ingestion host — defaults to the first-party reverse proxy at /ingest.
NEXT_PUBLIC_POSTHOG_HOST="/ingest"
# Server (posthog-node) host — the real PostHog region endpoint (EU).
POSTHOG_HOST="https://eu.i.posthog.com"
